  "build": {
    "appId": "com.optavel.slate",
    "productName": "Slate",
    "publish": {
      "provider": "github",
      "owner": "optavel",
      "repo": "slate-desktop-releases"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/slate-logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "runAfterFinish": true
    },
    "directories": {
      "buildResources": "public",
      "output": "dist_electron_output"
    }
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@eslint/js": "^9.19.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@types/node": "^22.13.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "baseline-browser-mapping": "^2.8.32",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.19.0",
