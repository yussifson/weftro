{
  "name": "slate",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./jsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "npm run build && npx cap sync",
    "cap:build": "npm run build && npx cap copy",
    "desktop:dev": "vite --mode electron",
    "desktop:build": "node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build --base ./ && electron-builder"
  },
