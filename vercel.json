{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self \"https://*.daily.co\"), microphone=(self \"https://*.daily.co\"), display-capture=(self \"https://*.daily.co\"), geolocation=(self), browsing-topics=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "https://wmabgiafwamxkcgxyhee.supabase.co/functions/v1/connect/mcp"
    },
    {
      "source": "/api/mcp",
      "destination": "https://wmabgiafwamxkcgxyhee.supabase.co/functions/v1/connect/mcp"
    },
    {
      "source": "/api/v1/mcp",
      "destination": "https://wmabgiafwamxkcgxyhee.supabase.co/functions/v1/connect/mcp"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "https://wmabgiafwamxkcgxyhee.supabase.co/functions/v1/connect/api/v1/:path*"
    },
    {
      "source": "/functions/v1/:path*",
      "destination": "https://wmabgiafwamxkcgxyhee.supabase.co/functions/v1/:path*"
    },
    {
      "source": "/oauth/init",
      "destination": "https://wmabgiafwamxkcgxyhee.supabase.co/functions/v1/oauth-init"
    },
    {
      "source": "/oauth/callback",
      "destination": "https://wmabgiafwamxkcgxyhee.supabase.co/functions/v1/oauth-callback"
    },
    {
      "source": "/api/ai/:accountId/:model*",
      "destination": "https://api.cloudflare.com/client/v4/accounts/:accountId/ai/run/:model*"
    },
    {
      "source": "/((?!api/|functions/|oauth/|mcp).*)",
      "destination": "/index.html"
    }
  ]
}
